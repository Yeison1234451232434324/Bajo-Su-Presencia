# Contexto de build: solo lo necesario para ejecutar la app.

.git
.github
.claude
.vscode
.idea

# Secretos — NUNCA deben entrar en la imagen.
**/.env
**/.env.*
*.pem
*.key

# Dependencias: se reinstalan dentro del contenedor.
**/vendor/
**/node_modules/

# Logs y temporales
**/logs/*.log
**/*.log

# Documentación (no se sirve)
*.md
docs/

# Herramientas de calidad (no se ejecutan en producción)
backend/tests/
backend/phpstan.neon
backend/phpcs.xml
backend/rector.php

# Herramientas de calidad (no se ejecutan en producción)
package.json
package-lock.json
.eslintrc.cjs
