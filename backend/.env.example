# ─────────────────────────────────────────────────────────────
#  ENTORNO
# ─────────────────────────────────────────────────────────────
APP_ENV=development            # production | development
APP_DEBUG=false

# ─────────────────────────────────────────────────────────────
#  SUPABASE (API REST)
#  Project Settings → API
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://jjpbmkydbdbqlynvqvcj.supabase.co
# Clave pública (anon) — usada para el login contra GoTrue.
SUPABASE_ANON_KEY=PON_AQUI_TU_ANON_KEY
# Clave de servicio (service_role) — SOLO en el servidor. NUNCA en el frontend.
# Se usa para leer/escribir tablas administrativas (intentos de login) saltando RLS.
SUPABASE_SERVICE_KEY=PON_AQUI_TU_SERVICE_ROLE_KEY

# ─────────────────────────────────────────────────────────────
#  JWT PROPIO DE LA APLICACIÓN
#  Genera el secreto:  php -r "echo bin2hex(random_bytes(32));"
# ─────────────────────────────────────────────────────────────
JWT_SECRET=CAMBIA_ESTE_SECRETO_64_HEX
JWT_ISSUER=bajo-su-presencia
JWT_TTL=300                   # 5 minutos (máximo estricto, en segundos)

# ─────────────────────────────────────────────────────────────
#  PROTECCIÓN CONTRA FUERZA BRUTA
# ─────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=3          # intentos fallidos permitidos
LOCKOUT_MINUTES=15            # minutos de bloqueo tras superar el límite

# ─────────────────────────────────────────────────────────────
#  CORS (orígenes permitidos, separados por coma, sin barra final)
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# ─────────────────────────────────────────────────────────────
#  RECUPERACIÓN DE CONTRASEÑA (token temporal)
# ─────────────────────────────────────────────────────────────
RESET_TOKEN_TTL=900          # vigencia del token en segundos (15 min)
# Página del frontend donde el usuario pega el token + nueva contraseña.
# El correo enviará: {RESET_URL_BASE}?token=XXXX
RESET_URL_BASE=http://localhost:5500/Bajo-Su-Presencia/views/public/login/reset-password.html

# ─────────────────────────────────────────────────────────────
#  CORREO (Gmail SMTP)
#  Usa una "Contraseña de aplicación" de Google (16 caracteres),
#  NO tu contraseña normal. Requiere verificación en 2 pasos activa.
#  https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tucorreo@gmail.com
MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME=Bajo Su Presencia
